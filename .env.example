# FinSight Environment Configuration

# ==================== JWT Secret ====================
# Generate a secure random string for JWT signing
JWT_SECRET=

# ==================== Discord Bot ====================
# https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# ==================== Database ====================
# PostgreSQL connection (default for docker-compose)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/finsight

# ==================== API URLs ====================
# Internal URLs (for docker-compose networking)
PYTHON_API_URL=http://finsight-bot:5000
EXPRESS_API_URL=http://localhost:3000

# ==================== Ollama ====================
# Internal URL for docker-compose
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral-nemo
